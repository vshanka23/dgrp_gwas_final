rule bam_sort_L001:
	input:
		config["DEST"]+"/3_align/1_rawbam/{SAMPLES_UNIQ}_L001.bam"
	output:
		config["DEST"]+"/3_align/2_sort/{SAMPLES_UNIQ}_L001_rsort.bam"
	params:
		config["DEST"]+"/3_align/1_rawbam/tmp_{SAMPLES_UNIQ}_L001"
	resources: cpus=4, mem_mb=20000, time_min=1440
	shell:
		"""
		module add samtools/1.10
		samtools sort \
		-n \
		-@ 4 \
		-T {params} \
		-o {output} \
		{input} ;
		"""
