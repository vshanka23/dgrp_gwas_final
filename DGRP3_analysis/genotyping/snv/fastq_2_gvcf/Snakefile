rule bam_merge_lanes:
	input:
		L1=config["DEST"]+"/3_align/4_possort/{SAMPLES_UNIQ}_L001_psort.bam",
		L2=config["DEST"]+"/3_align/4_possort/{SAMPLES_UNIQ}_L002_psort.bam"
	output:
		config["DEST"]+"/3_align/4_possort/{SAMPLES_UNIQ}_merged_psort.bam"
	resources: cpus=4, mem_mb=20000, time_min=1440
	shell:
		"""
		module add samtools/1.10
		samtools merge \
		-@ 4 \
		-f {output} \
		{input.L1} {input.L2} ;
		samtools index -@ 8 {output} ;
		"""

rule bam_markdup:
	input:
		config["DEST"]+"/3_align/4_possort/{SAMPLES_UNIQ}_merged_psort.bam"
	output:
		config["DEST"]+"/3_align/5_dedup/{SAMPLES_UNIQ}_dedup.bam"
	params:
		metrics=config["DEST"]+"/3_align/5_dedup/{SAMPLES_UNIQ}_bam.metrics",
		tmp_dir=config["DEST"]+"/3_align/5_dedup"
	resources: cpus=4, mem_mb=20000, time_min=1440
	shell:
		"""
		module add java_jdk/1.8.231
		module add picard/2.21.7
		module add gatk/4.1.4.1
		gatk --java-options "-Xmx20G -XX:ConcGCThreads=1" \
		MarkDuplicates \
		--USE_JDK_DEFLATER true \
		--USE_JDK_INFLATER true \
		--MAX_RECORDS_IN_RAM 50000 \
		--INPUT {input} \
		--METRICS_FILE {params.metrics} \
		--TMP_DIR {params.tmp_dir} \
		--CREATE_INDEX true \
		--OUTPUT {output} ;
		"""

rule bqsr:
	input:
		bam=config["DEST"]+"/3_align/5_dedup/{SAMPLES_UNIQ}_dedup.bam",
		knownvcf=config["KNOWNVCF"]
		
	output:
		config["DEST"]+"/3_align/6_bqsr/{SAMPLES_UNIQ}_recaltable.grp"
	params:
		config["REF"]
	resources: cpus=4, mem_mb=40000, time_min=1440
	shell:
		"""
		module add java_jdk/1.8.231
		module add picard/2.21.7 
		module add gatk/4.1.4.1
		module add htslib/1.9
		gatk BaseRecalibrator \
		-R {params} \
		-I {input.bam} \
		--known-sites {input.knownvcf} \
		-O {output} ;
		"""
		
rule recalibrate:
	input:
		bam=config["DEST"]+"/3_align/5_dedup/{SAMPLES_UNIQ}_dedup.bam",
		recaltable=config["DEST"]+"/3_align/6_bqsr/{SAMPLES_UNIQ}_recaltable.grp"
	output:
		config["DEST"]+"/3_align/6_bqsr/{SAMPLES_UNIQ}_recal.bam"
	params:
		config["REF"]
	resources: cpus=4, mem_mb=40000, time_min=1440
	shell:
		"""
		module add java_jdk/1.8.231
		module add picard/2.21.7 
		module add gatk/4.1.4.1
		module add htslib/1.9
		gatk ApplyBQSR \
		-R {params} \
		-I {input.bam} \
		-bqsr {input.recaltable} \
		-O {output} ;
		"""

rule haplotypecaller:
	input:
		config["DEST"]+"/3_align/6_bqsr/{SAMPLES_UNIQ}_recal.bam"
	output:
		VCF=config["DEST"]+"/4_varcall/{SAMPLES_UNIQ}_recal_g.vcf",
		BAMOUT=config["DEST"]+"/4_varcall/{SAMPLES_UNIQ}_recal_bamout.bam"
	params:
		config["REF"]
	resources: cpus=4, mem_mb=40000, time_min=1440
	shell:
		"""
		module add java_jdk/1.8.231
		module add gatk/4.1.4.1
		module add htslib/1.9
		gatk HaplotypeCaller \
		-I {input} \
		-O {output.VCF} \
		-R {params} \
		-ERC GVCF \
		--native-pair-hmm-threads 8 \
		-bamout {output.BAMOUT} ;
		"""
