configfile: "DGRP3_varcall.yaml"

SAMPLES=sorted(glob_wildcards(config["SOURCE"]+"/{samples}"+config["EXT"]).samples)
SAMPLES_NF=[]
import re
for item in SAMPLES:
	var1=re.sub('_L00[1-2]_R[1-2]','',str(item))
	SAMPLES_NF.append(var1)

SAMPLES_SET = set(SAMPLES_NF)
SAMPLES_UNIQ = list(SAMPLES_SET)

rule all:
	input:
		expand(config["DEST"]+"/4_varcall/{SAMPLES_UNIQ}_recal_g.vcf",SAMPLES_UNIQ=SAMPLES_UNIQ)

rule qc_L001:
	input:
		R1=config["SOURCE"]+"/{SAMPLES_UNIQ}_L001_R1"+config["EXT"],
		R2=config["SOURCE"]+"/{SAMPLES_UNIQ}_L001_R2"+config["EXT"]
	output:
		R1=config["DEST"]+"/2_qc/{SAMPLES_UNIQ}_L001_R1"+config["EXT"],
		R2=config["DEST"]+"/2_qc/{SAMPLES_UNIQ}_L001_R2"+config["EXT"],
		html=config["DEST"]+"/2_qc/{SAMPLES_UNIQ}_L001.html",
		json=config["DEST"]+"/2_qc/{SAMPLES_UNIQ}_L001.json"
	resources: cpus=4, mem_mb=20000, time_min=1440
	shell:
		"""
		module add fastp
		fastp \
		--thread 4 \
		-i {input.R1} \
		-I {input.R2} \
		-o {output.R1} \
		-O {output.R2} \
		-h {output.html} \
		-j {output.json}
		"""

rule qc_L002:
	input:
		R1=config["SOURCE"]+"/{SAMPLES_UNIQ}_L002_R1"+config["EXT"],
		R2=config["SOURCE"]+"/{SAMPLES_UNIQ}_L002_R2"+config["EXT"]
	output:
		R1=config["DEST"]+"/2_qc/{SAMPLES_UNIQ}_L002_R1"+config["EXT"],
		R2=config["DEST"]+"/2_qc/{SAMPLES_UNIQ}_L002_R2"+config["EXT"],
		html=config["DEST"]+"/2_qc/{SAMPLES_UNIQ}_L002.html",
		json=config["DEST"]+"/2_qc/{SAMPLES_UNIQ}_L002.json"
	resources: cpus=4, mem_mb=20000, time_min=1440
	shell:
		"""
		module add fastp
		fastp \
		--thread 4 \
		-i {input.R1} \
		-I {input.R2} \
		-o {output.R1} \
		-O {output.R2} \
		-h {output.html} \
		-j {output.json}
		"""
		
rule align_bwa_mem_L001:
	input:
		R1=config["DEST"]+"/2_qc/{SAMPLES_UNIQ}_L001_R1"+config["EXT"],
		R2=config["DEST"]+"/2_qc/{SAMPLES_UNIQ}_L001_R2"+config["EXT"]
	output:
		config["DEST"]+"/3_align/1_rawbam/{SAMPLES_UNIQ}_L001.bam"
	params:
		config["INDEX_REF"]
	resources: cpus=4, mem_mb=20000, time_min=1440
	shell:
		"""
		module add samtools/1.10
		module add bwa/0.7.17
		read_tmp=$(head -n 1 < <(zcat {input.R1}) | sed 's/:/\\t/g')
		readGroup="@RG\\\\tID:$(echo $read_tmp | awk '{{print $3 "." $4}}')\\\\tCN:ClemsonCHG\\\\tSM:{wildcards.SAMPLES_UNIQ}\\\\tLB:{wildcards.SAMPLES_UNIQ}\\\\tPL:illumina"
		bwa mem \
		-M \
		-t 4 \
		-R $readGroup \
		{params} \
		{input.R1} \
		{input.R2} | \
		samtools view -Sb - \
		> {output};
		"""
		
